[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/minimap.gd" id="1"]

[sub_resource type="Shader" id="Shader_masque_rond"]
code = "
shader_type canvas_item;

void fragment() {
	vec2 centre = vec2(0.5, 0.5);
	float dist = distance(UV, centre);
	vec4 couleur = texture(TEXTURE, UV);
	// En dehors du cercle (rayon 0.5) -> transparent
	float alpha_masque = 1.0 - smoothstep(0.48, 0.5, dist);
	COLOR = vec4(couleur.rgb, couleur.a * alpha_masque);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_masque"]
